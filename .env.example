# ===== SmalBlu environment variables =====
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel -> Project -> Settings -> Environment Variables
# for production. NONE of these are ever sent to the browser -
# they are only read inside server-side API routes (app/api/*).

# Google Gemini API key (server-side only, never exposed to client)
GEMINI_API_KEY=

# Postgres connection string (Neon, Supabase, Railway, RDS, etc.)
# If left empty, the app automatically falls back to an in-memory
# demo data store so it still runs/deploys without a DB configured.
DATABASE_URL=

# Redis connection string (Upstash Redis works great on Vercel)
# If left empty, an in-memory cache fallback is used instead.
REDIS_URL=

# JWT signing secret - generate with: openssl rand -base64 32
JWT_SECRET=

# SendGrid (optional - for email deadline alerts)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@smalblu.app

# AWS S3 (optional - for document/logo storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Secret used by Vercel Cron to authorize the deadline-check endpoint
CRON_SECRET=
