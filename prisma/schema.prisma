generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("member") // member | admin
  createdAt DateTime @default(now())
  applications AppliedGrant[]
}

model Grant {
  id           String   @id @default(cuid())
  title        String
  organization String
  country      String
  category     String
  amount       Float
  currency     String   @default("USD")
  deadline     DateTime
  description  String
  sourceUrl    String
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  applications AppliedGrant[]
}

model AppliedGrant {
  id          String   @id @default(cuid())
  grantId     String
  grant       Grant    @relation(fields: [grantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  status      String   @default("drafting") // drafting | submitted | in_review | awarded | rejected
  notes       String?
  submittedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
